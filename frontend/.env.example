# URL of the loony-ls3 server's public LS3 API (not the internal RPC or admin port).
# Requests are signed with SigV4 directly from the browser, so this must be the
# real address the browser will connect to -- there is no dev proxy in front of it.
VITE_API_URL=http://localhost:7353

# SigV4 region scope. Must match the server's LS3_REGION (defaults to us-east-1 on
# both sides if unset).
VITE_REGION=us-east-1

# The server's admin API, used by the admin panel. It only listens on loopback, so the
# panel only works when this UI is opened on the same machine (or through an SSH tunnel).
VITE_ADMIN_API_URL=http://127.0.0.1:7253
