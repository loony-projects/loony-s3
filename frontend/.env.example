# URL of the loony-s3 server's public S3 API (not the internal RPC or admin port).
# Requests are signed with AWS SigV4 directly from the browser, so this must be the
# real address the browser will connect to -- there is no dev proxy in front of it.
VITE_API_URL=http://localhost:9000

# SigV4 region scope. Must match the server's S3_REGION (defaults to us-east-1 on
# both sides if unset).
VITE_REGION=us-east-1
