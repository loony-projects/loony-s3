# Copy to frontend/.env.local (gitignored) and fill in. Every setting is required unless
# marked optional: there are no built-in defaults.

# Where `npm run dev` and `npm run preview` listen. The port is used exactly: if it's
# taken, the dev server stops instead of picking another one.
DEV_HOST=127.0.0.1
DEV_PORT=5173

# URL of the loony-ls3 server's public LS3 API (not the internal RPC or admin port).
# Requests are signed with SigV4 directly from the browser, so this must be the
# real address the browser will connect to -- there is no dev proxy in front of it.
VITE_API_URL=http://localhost:7353

# SigV4 region scope. Must match the server's LS3_REGION.
VITE_REGION=us-east-1

# The server's admin API, used by the admin panel. It only listens on loopback, so the
# panel only works when this UI is opened on the same machine (or through an SSH tunnel).
# Must match the server's LS3_ADMIN_ADDR.
VITE_ADMIN_API_URL=http://127.0.0.1:7253

# Optional: Sign in with Loony. Set both, or leave both out to only offer signing in with
# an access key. The server needs the matching LS3_OIDC_* settings, with
# http://DEV_HOST:DEV_PORT/callback (or the built site's address) as a redirect URI.
# See docs/configuration.md.
# VITE_OIDC_ISSUER=https://auth.example.com
# VITE_OIDC_CLIENT_ID=
