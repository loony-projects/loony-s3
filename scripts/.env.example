# Copy to scripts/.env (gitignored) and fill in. Variables already set in your shell
# take precedence over this file. Everything after `=` is the value: there are no
# inline comments, and one matching pair of surrounding quotes is stripped.
#
# Every value the scripts use comes from here: they have no built-in defaults. To run a
# second instance beside this one, copy this file to another name, such as scripts/.env.dev
# (also gitignored), give it different ports and folders, and run the scripts with
# LS3_ENV_FILE=scripts/.env.dev.

# Root SigV4 credential. Required by every script.
# Generate with e.g.: openssl rand -hex 10   /   openssl rand -hex 20
ACCESS_KEY=
SECRET_KEY=

# SigV4 region. Clients must use the same one.
REGION=us-east-1

# --- One server: serve.sh, start-standalone.sh, stop-standalone.sh -------------------

# Where the LS3 API listens.
BIND_ADDR=127.0.0.1:7353
# This server's data. serve.sh is for real data, so keep it out of /tmp.
DATA_DIR=/tmp/loony-standalone
# start-standalone.sh's pidfile, log and client env file.
STATE_DIR=/tmp/loony-standalone-run

# --- Local cluster: start-cluster.sh, stop-cluster.sh --------------------------------

# Bearer token for internal RPC between nodes.
# Generate with e.g.: openssl rand -hex 32
CLUSTER_TOKEN=
CLUSTER_ID=devcluster
CLUSTER_SIZE=3
# Each node's data goes in DATA_ROOT/node<n>, wiped on every start.
DATA_ROOT=/tmp/loony-cluster
CLUSTER_STATE_DIR=/tmp/loony-cluster-run
# Node n listens on each of these ports plus n-1.
CLUSTER_HOST=127.0.0.1
CLUSTER_API_PORT=7353
CLUSTER_ADMIN_PORT=7253
CLUSTER_RPC_PORT=9100

# --- Server settings ------------------------------------------------------------------
# Every LS3_* line here is passed to the server as is. See docs/configuration.md for all
# of them. Leave a line out to use the server's own default.

# The admin API. Must be a loopback address.
# LS3_ADMIN_ADDR=127.0.0.1:7253

# Sign in with Loony. Off unless the first four are all set.
# LS3_OIDC_ISSUER=https://auth.example.com
# LS3_OIDC_CLIENT_ID=
# LS3_OIDC_CLIENT_SECRET=
# LS3_OIDC_REDIRECT_URIS=https://console.example.com/callback
# LS3_OIDC_INTERNAL_URL=http://127.0.0.1:2001
# LS3_CONSOLE_SESSION_TTL_SECS=28800
# LS3_TRUSTED_IP_HEADER=CF-Connecting-IP

# Serves the built web UI (frontend/dist), for when there's no other web server.
# LS3_UI_DIR=/path/to/frontend/dist
# LS3_UI_ADDR=127.0.0.1:7354

# Billing. `test` turns on a simulated checkout that gives free credit: never use it where
# real people can sign in.
# LS3_BILLING_MODE=off
# LS3_BILLING_PLANS=[{"id":"standard","name":"Standard","price_paise":100000,"storage_bytes":16106127360,"period":{"months":1}}]
# LS3_BILLING_GRACE_SECS=604800
# LS3_BILLING_SUSPEND_AFTER_SECS=2592000
# LS3_BILLING_TICK_SECS=60
