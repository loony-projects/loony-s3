# Copy to scripts/.env (gitignored) and fill in. Variables already set in your shell
# take precedence over this file. Everything after `=` is the value: there are no
# inline comments, and one matching pair of surrounding quotes is stripped.

# Root SigV4 credential. Required by start-standalone.sh, start-cluster.sh, curl-demo.sh.
# Generate with e.g.: openssl rand -hex 10   /   openssl rand -hex 20
ACCESS_KEY=
SECRET_KEY=

# Bearer token for internal RPC between nodes. Required by start-cluster.sh.
# Generate with e.g.: openssl rand -hex 32
CLUSTER_TOKEN=

# Optional non-secret settings (defaults shown).
# REGION=us-east-1
# BIND_ADDR=127.0.0.1:9000
# DATA_DIR=/tmp/loony-standalone
# CLUSTER_ID=devcluster
# CLUSTER_SIZE=3
# DATA_ROOT=/tmp/loony-cluster
